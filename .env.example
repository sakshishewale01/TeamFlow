# ==============================================================================
# TeamFlow - Environment Variables Template
# ==============================================================================
# Copy this file to .env or .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your actual .env or .env.local file to version control.
# 2. NEVER put your Supabase service_role key into frontend code or this file.
# 3. Only use the public anon key for VITE_SUPABASE_ANON_KEY.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (safe to use in browser)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
